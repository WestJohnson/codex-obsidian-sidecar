{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skip": { "type": "boolean" },
    "title": { "type": "string" },
    "project_name": { "type": "string" },
    "project_slug": { "type": "string" },
    "current_phase": { "type": "string" },
    "summary": { "type": "string" },
    "objective": { "type": "string" },
    "outcome": { "type": "string" },
    "resume_context": { "type": "string" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedItemWithRationale" }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedItem" }
    },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedItem" }
    },
    "unresolved": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedItem" }
    },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedItem" }
    },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number" }
  },
  "required": [
    "skip",
    "title",
    "project_name",
    "project_slug",
    "current_phase",
    "summary",
    "objective",
    "outcome",
    "resume_context",
    "decisions",
    "changes",
    "verification",
    "unresolved",
    "next_actions",
    "topics",
    "confidence"
  ],
  "$defs": {
    "evidencedItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["text", "evidence_ids"]
    },
    "evidencedItemWithRationale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "rationale": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["text", "rationale", "evidence_ids"]
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "disposition": {
          "type": "string",
          "enum": ["blocker", "scheduled", "monitor", "accepted", "dropped"]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["text", "disposition", "evidence_ids"]
    }
  }
}
