{
  "vault_path": "/srv/obsidian-vault",
  "state_dir": "/var/lib/obsidian-cloud",
  "codex_bin": "/usr/bin/false",
  "model": "gpt-5.6-luna",
  "reasoning_effort": "low",
  "debounce_seconds": 180,
  "curator_timeout_seconds": 240,
  "minimum_confidence": 0.65,
  "basic_memory_project": "codex-vault",
  "auto_git_backup": true,
  "git_checkpoint_interval_seconds": 3600,
  "runtime_role": "cloud",
  "syncthing_config_path": "/var/lib/obsidian-sync/.local/state/syncthing/config.xml",
  "syncthing_url": "http://127.0.0.1:8384",
  "syncthing_folder_id": "codex-obsidian-vault",
  "syncthing_peer_id": "LOCAL-DEVICE-ID",
  "cloud_agent_enabled": true,
  "cloud_agent_model": "openai/gpt-5.6-luna",
  "cloud_agent_base_url": "https://openrouter.ai/api/v1",
  "cloud_agent_max_input_chars": 60000,
  "cloud_agent_max_completion_tokens": 3000,
  "cloud_agent_daily_cost_limit_usd": 0.0,
  "cloud_agent_monthly_cost_limit_usd": 0.0,
  "cloud_agent_cost_reserve_usd": 0.10,
  "cloud_backup_dir": "/var/backups/obsidian-vault",
  "cloud_backup_retention": 30,
  "cloud_lease_ttl_seconds": 1800,
  "cloud_settle_timeout_seconds": 90,
  "cloud_reconnect_min_interval_seconds": 600,
  "alerts_enabled": false,
  "alert_cooldown_seconds": 86400,
  "staged_report_alert_hours": 24,
  "cloud_status_ssh_host": "",
  "cloud_status_probe_interval_seconds": 900
}
